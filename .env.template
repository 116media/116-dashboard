VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_PRESET=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_GOOGLE_API_KEY=

# Application URLs
VITE_API_URL=
VITE_FRONTEND_STAGING_URL=
VITE_FRONTEND_PRODUCTION_URL=
