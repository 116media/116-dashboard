# ===================================================================
# SECURITY WARNING: MOVE TO SERVER-SIDE ONLY
# ===================================================================
# These variables contain sensitive data and should NOT be exposed to clients.
# Remove VITE_ prefix and move to server-side API endpoints.

VITE_CLOUDINARY_SECRET=
VITE_JWT_SECRET_KEY=
VITE_CRYPTO_PASSPHASE=

# Encryption key for redux-persist-transform-encrypt.
# Used to AES-256 encrypt the persisted Redux auth state in localStorage.
# If this key changes, all existing sessions are invalidated (users must re-login).
# Tampered data triggers automatic logout via the onError handler in store.ts.
VITE_PERSIST_SECRET_KEY=

VITE_OTP_EXPIRATION_MINUTES=60

CLIENT_APP=Dashboard
